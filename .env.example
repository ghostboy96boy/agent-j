# Copy to .env before running `make up`.
# Regtest-only credentials. Do not reuse anywhere else.
BTC_RPC_USER=agentj
BTC_RPC_PASS=agentj-regtest-only

# Pinned images. If a tag fails to pull, check the latest tag on Docker Hub
# and update it here (keep versions pinned, never use "latest").
BITCOIND_IMAGE=lncm/bitcoind:v27.0
# v0.20.0-beta matches lightning-agent-tools; lnget needs lnd >= 0.19.
LND_IMAGE=lightninglabs/lnd:v0.20.0-beta
CLN_IMAGE=elementsproject/lightningd:v24.08.2
# Lightning Agent Kit L402 stack (make up-lak); defaults are in docker-compose.yml
APERTURE_IMAGE=lightninglabs/aperture:v0.4.3
WEATHERLN_IMAGE=python:3.12-alpine

# Model APIs (free tiers are enough for phase 0). Never commit real keys.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional fallback
OPENROUTER_API_KEY=
